<Project>

  <!--
    Solution-wide build settings. See docs/ARCHITECTURE.md §4.1 (runtime policy)
    and §5.3 (dependency rules, enforced by test/PersonalRecorder.ArchitectureTests).
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Company>NimbleJinn LLC</Company>
    <Product>Personal Recorder</Product>
    <Authors>NimbleJinn LLC</Authors>
    <Copyright>Copyright © 2026 NimbleJinn LLC</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
