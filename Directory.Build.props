<Project>

  <!--
    Solution-wide build settings. See docs/ARCHITECTURE.md §4.1 (runtime policy)
    and §5.3 (dependency rules, enforced by test/PersonalRecorder.Tests).
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      IncludeMobileTargets=false drops the net10.0-android flavour of multi-targeted projects,
      so a host without the Android workload (the CI "core" job, a service-only checkout) can
      still restore, build and test everything portable. Android-only projects (App, Harness)
      are left out by the solution filter PersonalRecorder.WorkloadFree.slnf instead.
    -->
    <IncludeMobileTargets Condition="'$(IncludeMobileTargets)' == ''">true</IncludeMobileTargets>
  </PropertyGroup>

  <PropertyGroup>
    <Company>NimbleJinn LLC</Company>
    <Product>Personal Recorder</Product>
    <Authors>NimbleJinn LLC</Authors>
    <Copyright>Copyright © 2026 NimbleJinn LLC</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
