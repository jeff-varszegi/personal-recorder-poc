<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PersonalRecorder.Tests — one test project, with namespaces mirroring what they test:
    .Core, .Client, .Service, and .Architecture (the dependency rules of ARCHITECTURE.md §5.3,
    checked at project level from the .csproj files and at namespace level from the compiled IL).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PersonalRecorder.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.eNhancedEdition" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\components\core\PersonalRecorder.Core\PersonalRecorder.Core.csproj" />
    <ProjectReference Include="..\..\components\client\PersonalRecorder.Client\PersonalRecorder.Client.csproj" />
    <ProjectReference Include="..\..\components\service\PersonalRecorder.Service\PersonalRecorder.Service.csproj" />
    <ProjectReference Include="..\..\components\verifier\PersonalRecorder.Verifier\PersonalRecorder.Verifier.csproj" />
  </ItemGroup>

</Project>
